### ⑥ 発見ペット本体を登録（/pets/found）
# ★修正：photoUrl(単数) → photoUrls(配列)に変更
# @name foundPetRegister
POST http://localhost:8080/pets/found
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJyZWxpbmstYXBpIiwiYXVkIjoicmVsaW5rLXVzZXJzIiwidXNlcklkIjoidGVzdC11c2VyLTEiLCJyb2xlIjoiZmluZGVyIiwiZXhwIjoxNzg4MTc4MDUwfQ.UCXoDCgi-Eeb5xseAPFcUBgidbBK53FA83msHPcqBd4
Content-Type: application/json

{
  "photoUrls": ["https://cdjilctcmrzyijttaqnu.supabase.co/storage/v1/object/public/pet-photos/2500f2f9-ab77-4c3d-857a-0a38d70d1b70_test.jpg"],
  "foundPlace": "石川県 輪島市 ○○町",
